<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="APH-Search">
            <Action name="APHSEARCH_TOGGLE">
                <Down>APHSearchCore.ToggleBar()</Down>
            </Action>
            <Action name="APHSEARCH_GUIDE_TOGGLE">
                <Down>APHSearchCore.Guide.Toggle()</Down>
            </Action>
            <Action name="APHSEARCH_GUIDE_NEXT_MEMBER">
                <Down>APHSearchCore.GuideTrack.NextMember()</Down>
            </Action>
            <Action name="APHSEARCH_GUIDE_RECORD">
                <Down>APHSearchCore.GuideRecord.Toggle()</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
